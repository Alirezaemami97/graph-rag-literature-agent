# Copy this file to .env and fill in your values. Never commit .env.

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your-key-here
AZURE_OPENAI_API_VERSION=2024-02-01

# Neo4j (matches docker-compose defaults)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=litagent-dev

# OpenAlex polite pool (use your real email — no auth required, just polite)
OPENALEX_EMAIL=your-email@example.com

# Azure OpenAI chat model (separate deployment from the embedding model)
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o

# LangSmith tracing — sign up free at smith.langchain.com
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your-langsmith-key
LANGCHAIN_PROJECT=litagent-dev
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
